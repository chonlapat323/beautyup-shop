generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Localized text is stored as JSON: { "th": "...", "en": "..." }
// (see `localized` in packages/types). Thai is required, English falls back to Thai.

enum Role {
  ADMIN
  STAFF
}

enum BrandType {
  SALON
  COUNTER
}

enum Region {
  BANGKOK_CENTRAL
  EAST
  WEST
  NORTH
  SOUTH
  NORTHEAST
}

enum PostType {
  ARTICLE
  ACTIVITY
  MEDIA
}

enum Department {
  SALES
  TECHNICIAN
  FINANCE
  LEGAL
}

enum InquiryType {
  CONTACT
  ORDER
  SALON
  COURSE
  ISSUE
  PP_STUDIO
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// Admin panel users
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuItem {
  id           String     @id @default(cuid())
  label        Json
  href         String
  location     String     @default("header")
  parentId     String?
  parent       MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuTree")
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  brandId      String?
  brand        Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandSlug    String?    @default("")
  showProducts Boolean    @default(true)
  slides       Json       @default("[]")
  sections     Json       @default("[]")
}

model Brand {
  id          String      @id @default(cuid())
  slug        String      @unique
  type        BrandType
  name        String
  localName   Json
  country     Json
  tagline     Json
  description Json
  highlights  Json        @default("[]")
  features    Json        @default("[]")
  series      Json        @default("[]")
  logoUrl     String      @default("")
  website     String      @default("")
  catalogUrl  String      @default("")
  socials     Json        @default("{}")
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  categories  Category[]
  products    Product[]
  heroSlides  HeroSlide[]
  menuItems   MenuItem[]
}

model Category {
  id            String    @id @default(cuid())
  slug          String
  name          Json
  subtitle      Json?
  description   Json?
  highlights    Json?
  imageUrl      String    @default("")
  bannerUrl     String    @default("")
  accentColor   String    @default("#d6297f")
  subCategories Json      @default("[]")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brandId       String
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([brandId, slug])
  @@index([brandId])
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        Json
  description Json
  category    String    @default("")
  categoryId  String?
  categoryRel Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series      String    @default("")
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  price       Decimal   @db.Decimal(12, 2)
  salePrice   Decimal?  @db.Decimal(12, 2)
  badges      String[]
  imageUrl    String    @default("")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([category])
}

model HeroSlide {
  id        String  @id @default(cuid())
  brandId   String?
  brand     Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  product   Json
  caption   Json
  href      String
  imageUrl  String  @default("")
  tint      String  @default("#d6297f")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Video {
  id         String  @id @default(cuid())
  title      Json
  youtubeUrl String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model Ambassador {
  id        String  @id @default(cuid())
  name      String
  title     Json
  photoUrl  String  @default("")
  socials   Json    @default("{}")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Salon {
  id        String   @id @default(cuid())
  name      String
  region    Region
  province  String
  address   String   @default("")
  phone     String   @default("")
  mapUrl    String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([region])
}

model Course {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     Json
  priceText Json
  duration  Json
  summary   Json
  content   Json
  coverUrl  String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  type        PostType
  title       Json
  excerpt     Json
  body        Json
  coverUrl    String    @default("")
  videoUrl    String    @default("")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, publishedAt])
}

/// Static content pages: policy, payment, about ...
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     Json
  body      Json
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id         String     @id @default(cuid())
  name       Json
  position   Json
  department Department
  phone      String     @default("")
  lineId     String     @default("")
  photoUrl   String     @default("")
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  status    InquiryStatus @default(NEW)
  name      String
  phone     String        @default("")
  email     String        @default("")
  shopName  String        @default("")
  province  String        @default("")
  message   String        @default("")
  data      Json          @default("{}")
  note      String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

/// company, timeline, ppStudio, regionCounts (see packages/types settingSchemas)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Website members (separate from admin `User`s). Sign up with email/password or Google.
model Member {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  name         String
  phone        String    @default("")
  shopName     String    @default("")
  province     String    @default("")
  avatarUrl    String    @default("")
  locale       String    @default("th")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}
