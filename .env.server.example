# Root .env for the production server (beautyup-server).
#   cp .env.server.example .env
# Read by ecosystem.config.cjs, scripts/check-ports.cjs and docker compose.
#
# Ports already taken on the server (checked 2026-10-12 with `ss -ltnp`):
#   3000-3003 PM2 (old beautyup, line, starsoft) · 3100 next-server
#   5432 postgres · 5433/5434/5050 docker · 80/443/2019 caddy

API_PORT=4200
WEB_PORT=3200
ADMIN_PORT=3201
DB_PORT=5435

# Listen on localhost only; Caddy proxies the public domains to these ports
HOST=127.0.0.1

# PostgreSQL container password (use the same in apps/api/.env DATABASE_URL)
DB_PASSWORD=change-me-to-a-long-random-password
